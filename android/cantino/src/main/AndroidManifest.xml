<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into every app that uses the library. Area downloads (AreaManager)
     need the network; ACCESS_NETWORK_STATE lets WorkManager hold a download
     until a connection is available. Apps that never download can remove them
     with tools:node="remove" (the offline basemap sample app does).

     Deliberately absent: the foreground-service entries of foreground mode
     (AreaConfig.foreground, opt-in). FOREGROUND_SERVICE_DATA_SYNC and a
     dataSync service type make Google Play ask every app for a foreground
     service declaration, so apps that enable foreground mode add them
     themselves (snippet in ForegroundConfig's KDoc and CHANGELOG.md). Without
     them a foreground-mode run logs a warning and runs in the background. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
