// Clang module for the Cantino C ABI. The header path is relative to this
// file and points at the repository's single copy of the header
// (include/cantino.h), so the Swift adapter can never compile against a
// stale duplicate. Linux only; Apple platforms get the module from the
// xcframework (scripts/build-xcframework.sh). Linking is in Package.swift.
module CCantino [system] {
    header "../../../include/cantino.h"
    export *
}
